---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import PreLaunchBanner from '../components/PreLaunchBanner.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CartRoot from '../components/CartRoot.astro';
import { SITE } from '../data/site';

interface Props {
  /** Page title; optional on the homepage, which uses the brand + tagline. */
  title?: string;
  description?: string;
  isHome?: boolean;
  noindex?: boolean;
}

const { title = SITE.name, description, isHome = false, noindex = false } = Astro.props;
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <BaseHead
      title={title}
      description={description}
      isHome={isHome}
      noindex={noindex}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <PreLaunchBanner />
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    <CartRoot />
  </body>
</html>
