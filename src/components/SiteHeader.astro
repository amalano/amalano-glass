---
import { SITE, NAV } from '../data/site';
import { href } from '../lib/url';

const current = (Astro.url.pathname.replace(/\/+$/, '') || '/');

function isCurrent(path: string): boolean {
  if (path.includes('#')) return false;
  const target = href(path).replace(/\/+$/, '') || '/';
  return target === current;
}
---

<header class="masthead">
  <div class="container masthead__inner">
    <a href={href('/')} class="wordmark" aria-label={`${SITE.name} — home`}>
      {SITE.wordmark}
    </a>

    <nav class="mainnav" aria-label="Primary">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a
                href={href(item.path)}
                aria-current={isCurrent(item.path) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <button
        type="button"
        class="cart-button"
        data-cart-open
        aria-haspopup="dialog"
        aria-controls="cart-dialog"
        aria-label="Open cart, 0 items"
      >
        <svg
          viewBox="0 0 24 24"
          width="20"
          height="20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M7 3h10l-.7 5.2a4.4 4.4 0 0 1-8.6 0Z" />
          <path d="M12 14v6" />
          <path d="M8.5 20.5h7" />
        </svg>
        <span class="cart-button__label">Cart</span>
        <span class="cart-badge" data-cart-count data-empty="true" aria-hidden="true">0</span>
      </button>
    </div>
  </div>
</header>
